YOUTUBE_PLAYLIST_ID=PLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET_FILE=./client_secret.json
TOKEN_FILE=./token.json
HISTORY_FILE=./shuffle-history.json

# More candidates means a smarter shuffle, but slightly slower local calculation.
SHUFFLE_CANDIDATES=800
SHUFFLE_HISTORY_SIZE=5

# Set to true if you want npm run shuffle to preview only.
DRY_RUN=false
